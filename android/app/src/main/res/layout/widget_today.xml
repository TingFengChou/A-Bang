<?xml version="1.0" encoding="utf-8"?>
<!-- 主畫面小工具「阿幫・今天」（AbangTodayWidget）。RemoteViews 只能用 LinearLayout、TextView、ImageView 這類 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_today_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#14201D"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_kind_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textColor="#0F766E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_say"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_say_bg"
        android:padding="8dp"
        android:textColor="#14201D"
        android:textSize="14sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_tip1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#B45309"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_tip2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#B45309"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#5F6F6B"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
