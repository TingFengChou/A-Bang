# 複製成 .env 後填入。.env 不可提交（.gitignore 已排除）。全部留空 = 示範模式。

# ── 伺服器 ──
PORT=8787
# 1 = 強制示範模式（即使有金鑰）
DEMO_MODE=0
# 示範時鐘（只在 DEMO_MODE=1 有效）：把「現在」固定在今天這個台灣時間，例 23:30 看末班車提醒；E2E 用 10:00
# DEMO_CLOCK=23:30
# 1 = 位於反向代理後，採用 X-Forwarded-For 做限流
TRUST_PROXY=0
# 每 IP 每分鐘上限
RATE_LIMIT_API=120
RATE_LIMIT_MCP=60
# stdio MCP 只暴露指定工具包（逗號分隔，例如 transit,weather）；留空 = 全部
MCP_PACKS=

# ── 交通部 TDX（https://tdx.transportdata.tw → 會員中心 → API 金鑰）──
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# 每分鐘呼叫上限（基本會員 5；TDX 回應標頭會自動校正）
# TDX_PER_MINUTE=5
# 靜態資料（站牌、站序、車站）存檔目錄，重啟後先讀檔；預設 .cache/tdx，off＝不存檔（只存正規化結果，不存金鑰與使用者位置）
# TDX_CACHE_DIR=.cache/tdx
# 背景預熱與本機查附近站牌的縣市（逗號分隔）；預設 Taipei,NewTaipei,Taoyuan
# TDX_PREWARM_CITIES=Taipei,NewTaipei,Taoyuan
# 0＝伺服器啟動後不預熱（預熱每分鐘最多用 3 次，留 2 次給使用者）
# TDX_PREWARM=1

# ── 中央氣象署開放資料平臺授權碼（M3：weather_now）──
CWA_API_KEY=

# ── 免金鑰政府開放資料（M7：165 防詐）。預設下載真實資料；設 0 改用示範片段（不連網）──
# OPEN_DATA=0

# ── 環境部環境資料開放平臺 api_key（M10：空氣品質；沒有時用示範片段）──
MOENV_API_KEY=

# ── 網頁 agent（M5，ADR-0012）──
# 模式：claude | local | demo；留空＝自動（有 ANTHROPIC_API_KEY → claude；有 LOCAL_LLM_URL＋LOCAL_LLM_MODEL → local；否則 demo）
AGENT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 測試用假 API（選填）
ANTHROPIC_BASE_URL=
# 地端模型（OpenAI 相容 API：Ollama、LM Studio、llama.cpp、vLLM）
# Ollama 例：LOCAL_LLM_URL=http://localhost:11434/v1、LOCAL_LLM_MODEL=qwen3:8b
# （Ollama 預設 context 4096 太小，請以 OLLAMA_CONTEXT_LENGTH=16384 啟動）
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# 選填：伺服器需要時才填
LOCAL_LLM_API_KEY=
# 選填：推理模型的思考強度（OpenAI 相容 reasoning_effort）；Ollama 的 qwen3 設 none 可關閉思考，回應快很多
LOCAL_LLM_REASONING_EFFORT=
AGENT_RPM=10
AGENT_RPD=100
AGENT_DAILY_BUDGET=5000

# ── MyDrama 短劇（ADR-0019）：由合作方提供，只放 .env，不要寫進 repo（repo 是公開的）──
# 沒設定 MYDRAMA_API_BASE 時用虛構的示範片庫；連結沒設定時卡片不給「在 MyDrama 看」
# 公開讀取 API 的網址（https；本機開發可 http://localhost）
MYDRAMA_API_BASE=
# 某劇某集的 App 連結範本，用 {id}、{ep} 代入（自訂 scheme 或 https）
MYDRAMA_LINK_EPISODE=
# App 內活動頁的連結（給之後的運動建議用）
MYDRAMA_LINK_EXERCISE=
# 沒裝 App 時開的商店頁（https）
MYDRAMA_STORE_IOS=
MYDRAMA_STORE_ANDROID=

# ── 示範模式情境（選填，展示用）──
# rain | clear
DEMO_WEATHER=
# jam | smooth
DEMO_TRAFFIC=
# bad | good（示範空品；bad 時行程自動加「空品不佳」）
DEMO_AIR=
# 固定「現在」，例如 2026-12-01T07:30:00+08:00
DEMO_NOW=

# ── 實驗：意圖與狀態判斷（npm run eval:decision，docs/research/decision-eval.md）──
# TypeSafe Jev（System One 決策模型）；沒有設定時只跑規則與地端模型。評估集是假想提問，不含使用者資料
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# ── 判斷層（core/agent/judge.js，AGENT.md §5.3）──
# 意圖與使用者狀態：嵌入分類器（首次啟動下載約 120 MB 模型）＋地端模型（有 LOCAL_LLM_URL 時）＋規則。off＝只用規則
# JUDGE=off
# JUDGE_MODEL_DIR=./node_modules/.cache/transformers

# ── 手機 App（ADR-0013）──
# 問阿幫與 REST 讀取路由額外允許的 App WebView 來源（逗號分隔）；預設 Capacitor 的 iOS 與 Android
# APP_ORIGINS=capacitor://localhost,https://localhost
# 打包 App 時的伺服器網址（npm run build:app；正式版要 https，搭配 APP_RELEASE=1 檢查）
# ABANG_API_BASE=https://abang.example.tw
