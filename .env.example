# 複製成 .env 後填入。.env 不可提交（.gitignore 已排除）。全部留空 = 示範模式。

# ── 伺服器 ──
PORT=8787
# 1 = 強制示範模式（即使有金鑰）
DEMO_MODE=0
# 1 = 位於反向代理後，採用 X-Forwarded-For 做限流
TRUST_PROXY=0
# 每 IP 每分鐘上限
RATE_LIMIT_API=120
RATE_LIMIT_MCP=60
# stdio MCP 只暴露指定工具包（逗號分隔，例如 transit,weather）；留空 = 全部
MCP_PACKS=

# ── 交通部 TDX（https://tdx.transportdata.tw → 會員中心 → API 金鑰）──
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ── 中央氣象署開放資料平臺授權碼（M3：weather_now）──
CWA_API_KEY=

# ── 網頁 agent（M5）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 測試用假 API（選填）
ANTHROPIC_BASE_URL=
AGENT_RPM=10
AGENT_RPD=100
AGENT_DAILY_BUDGET=5000

# ── 示範模式情境（選填，展示用）──
# rain | clear
DEMO_WEATHER=
# jam | smooth
DEMO_TRAFFIC=
# 固定「現在」，例如 2026-12-01T07:30:00+08:00
DEMO_NOW=
