{
  "name": "abang",
  "version": "0.1.0",
  "description": "阿幫 A-Bang：台灣公共資料 AI 助手（PWA + MCP Server，共用核心）",
  "main": "core/index.js",
  "scripts": {
    "start": "node server/http.js",
    "mcp": "node mcp/server.js",
    "build:demo": "node scripts/build-demo.js",
    "eval:decision": "node scripts/eval-decision.js",
    "build:cards": "node scripts/build-cards.js",
    "build:app": "node scripts/build-app.js",
    "app:sync": "node scripts/build-app.js && cap sync",
    "ios:dev": "node scripts/ios-dev-install.js",
    "test": "node --test test/*.test.js",
    "e2e": "node --test scripts/e2e.js",
    "lint": "eslint .",
    "fetch:judge-model": "node scripts/fetch-judge-model.js",
    "smoke:android": "node scripts/smoke-android.js",
    "smoke:ios": "node scripts/smoke-ios.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gsap": "^3.15.1",
    "swagger-ui-dist": "5.34.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "abang-mcp": "mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "globals": "17.13.0",
    "playwright": "1.64.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
