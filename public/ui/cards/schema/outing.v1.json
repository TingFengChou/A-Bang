{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abang/cards/outing.v1.json",
  "title": "outing（outing_advice）",
  "type": "object",
  "required": ["weather", "air", "items"],
  "properties": {
    "name": { "type": "string" },
    "weather": {
      "type": ["object", "null"],
      "required": ["station", "tempC", "pop3h", "raining"],
      "properties": {
        "station": { "type": "string" },
        "town": { "type": "string" },
        "tempC": { "type": ["number", "null"] },
        "pop3h": { "type": ["integer", "null"] },
        "raining": { "type": "boolean" },
        "rainMm1h": { "type": ["number", "null"] },
        "summary": { "type": "string" }
      }
    },
    "air": {
      "type": ["object", "null"],
      "required": ["site", "aqi", "status"],
      "properties": {
        "site": { "type": "string" },
        "aqi": { "type": ["integer", "null"] },
        "status": { "type": "string" },
        "level": { "type": ["string", "null"] }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["kind", "level", "text"],
        "properties": {
          "kind": { "enum": ["umbrella", "hot", "cold", "mask", "ok"] },
          "level": { "enum": ["warn", "info", "ok"] },
          "text": { "type": "string" }
        }
      }
    }
  }
}
