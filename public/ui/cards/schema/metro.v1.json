{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abang/cards/metro.v1.json",
  "title": "metro（metro_live_board）",
  "type": "object",
  "required": ["system", "station", "stationId", "updatedAt", "trains", "nav"],
  "properties": {
    "system": { "enum": ["TRTC", "TYMC", "TMRT", "KRTC", "NTMC", "NTDLRT", "NTALRT", "KLRT"] },
    "station": { "type": "string" },
    "stationEn": { "type": "string" },
    "stationId": { "type": "string" },
    "lat": { "type": "number" },
    "lon": { "type": "number" },
    "nav": { "type": ["object", "null"], "required": ["google", "apple"], "properties": { "google": { "type": "string" }, "apple": { "type": "string" } } },
    "updatedAt": { "type": "string" },
    "demo": { "type": "boolean" },
    "source": { "enum": ["live", "timetable", "mixed", "frequency"] },
    "headway": { "type": ["object", "null"], "description": "source frequency（台中捷運只有班距）：現在幾分鐘一班；null＝不在營運時間", "required": ["min", "max"], "properties": { "min": { "type": "integer" }, "max": { "type": "integer" }, "peak": { "type": "boolean" }, "lineId": { "type": ["string", "null"] }, "lineColor": { "type": "string" } } },
    "note": { "type": "string" },
    "noteEn": { "type": "string" },
    "stale": { "type": "boolean" },
    "lastTrains": { "type": "array", "description": "問末班車時（last: true）：依時刻表各線各方向今天最後一班", "items": { "type": "object", "required": ["destination", "time"], "properties": { "lineId": { "type": ["string", "null"] }, "line": { "type": "string" }, "destination": { "type": "string" }, "destinationEn": { "type": "string" }, "time": { "type": "string" } } } },
    "trains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "destination", "etaMin", "status"],
        "additionalProperties": false,
        "properties": {
          "line": { "type": "string" },
          "lineEn": { "type": "string" },
          "lineId": { "type": ["string", "null"] },
          "lineColor": { "type": "string" },
          "destination": { "type": "string" },
          "destinationEn": { "type": "string" },
          "etaMin": { "type": ["integer", "null"] },
          "status": { "enum": ["arriving", "approaching", "minutes", "scheduled", "unknown"], "description": "狀態代碼（卡片用字典顯示）：arriving 進站中（看板 EstimateTime 0）、approaching 1 分內、minutes N 分、scheduled 依時刻表估算、unknown 沒有時間" },
          "scheduled": { "type": "boolean" }
        }
      }
    }
  }
}
