{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abang/cards/trip.v1.json",
  "title": "trip（plan_trip）",
  "type": "object",
  "required": ["from", "to", "best", "options", "ranking", "states", "departAt"],
  "properties": {
    "from": { "$ref": "#/$defs/place" },
    "to": { "$ref": "#/$defs/place" },
    "straightKm": { "type": "number" },
    "date": { "type": "string" },
    "departAt": { "type": "string" },
    "party": { "type": "integer", "minimum": 2 },
    "tips": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["kind", "text"], "properties": { "kind": { "enum": ["tight", "rain", "cost"] }, "text": { "type": "string" } } } },
    "tight": { "type": "object", "required": ["slackMin"], "properties": { "slackMin": { "type": "integer", "minimum": 0 } } },
    "arriveBy": { "type": "string" },
    "arriveByMin": { "type": "integer" },
    "best": { "type": ["string", "null"] },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "source"],
        "properties": {
          "key": { "enum": ["rush", "traffic", "rain", "luggage", "budget", "lessWalk", "badAir", "elder", "kids", "mobility", "group", "rainSoon"] },
          "source": { "enum": ["auto", "user", "picked", "usual"] },
          "from": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "weather": { "type": ["object", "null"] },
    "traffic": { "type": ["object", "null"] },
    "air": { "type": ["object", "null"] },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "ranking": {
      "type": "object",
      "required": ["ranked", "excluded", "reason"],
      "properties": {
        "ranked": { "type": "array", "items": { "type": "object", "required": ["id", "name", "score"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "score": { "type": "integer" }, "breakdown": { "type": "object" }, "notWorth": { "type": "object", "properties": { "vs": { "type": "string" }, "extra": { "type": "number" }, "worth": { "type": "number" } } }, "tooLong": { "type": "object", "properties": { "vs": { "type": "string" }, "cap": { "type": "number" } } }, "unsure": { "type": "object", "description": "到站時間不明的公車讓位給時間確定的大眾運輸（vs）", "properties": { "vs": { "type": "string" } } } } } },
        "excluded": { "type": "array", "items": { "type": "object", "required": ["id", "why"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "why": { "type": "string" } } } },
        "weights": { "type": "object" },
        "reason": { "type": "string" }
      }
    },
    "unavailable": { "type": "array", "items": { "type": "string" } },
    "mode": { "enum": ["walk", "bike", "bus", "metro", "thsr", "tra", "intercity", "ridehail", "drive"] },
    "avoid": { "type": "array", "items": { "enum": ["walk", "bike", "bus", "metro", "thsr", "tra", "intercity", "ridehail", "drive"] } },
    "habit": { "type": "object" },
    "habitOn": { "type": "boolean" },
    "ask": { "type": "object", "required": ["state", "text"], "properties": { "state": { "enum": ["rush", "budget", "luggage", "lessWalk"] }, "text": { "type": "string" }, "textEn": { "type": "string" } } },
    "skipped": { "type": "array", "items": { "$ref": "#/$defs/notIn" } },
    "missing": { "type": "array", "description": "沒列入的方式與原因（含 skipped；太近、太遠不列）：卡片「沒列入」清單、決策圖", "items": { "$ref": "#/$defs/notIn" } },
    "limited": {
      "type": "object",
      "description": "TDX 額度用完、這次沒列入的方式（示範資料不參加排名）：一句照實說；noTransit＝大眾運輸因此一個都沒有",
      "required": ["roles", "noTransit", "text"],
      "properties": {
        "roles": { "type": "array", "items": { "enum": ["bike", "bus", "metro", "thsr", "tra", "intercity"] } },
        "noTransit": { "type": "boolean" },
        "text": { "type": "string" },
        "textEn": { "type": "string" }
      }
    },
    "night": {
      "type": "object",
      "description": "深夜的一句：公車、捷運收班（closed）或末班快到了（late）；卡片第一行、回答第一句",
      "required": ["text", "closed", "late"],
      "properties": {
        "text": { "type": "string" },
        "textEn": { "type": "string" },
        "closed": { "type": "array", "items": { "enum": ["bus", "metro"] } },
        "late": { "type": "array", "items": { "enum": ["bus", "metro"] } },
        "estimated": { "type": "boolean" },
        "fallback": { "const": "tdx-limit" }
      }
    }
  },
  "$defs": {
    "notIn": {
      "type": "object",
      "required": ["role", "why"],
      "properties": {
        "role": { "enum": ["walk", "bike", "bus", "metro", "thsr", "tra", "intercity", "ridehail", "drive"] },
        "kind": { "enum": ["skipped", "none", "noService", "route"], "description": "skipped 查了但不可行（收班、沒車位）、none 查不到站或路線、noService 沒有趕得上的班次、route 這一條公車路線今天不會來（另一條照常列入）" },
        "route": { "type": "string", "description": "kind route：公車路線名稱" },
        "status": { "enum": [2, 3, 4], "description": "kind route：上車站的到站狀態（2 交管不停靠、3 末班已過、4 今日未營運）" },
        "why": { "type": "string" },
        "whyEn": { "type": "string" },
        "closed": { "type": "boolean", "description": "收班（深夜公車、捷運）" },
        "first": { "type": "string", "description": "捷運收班時：首班約幾點（HH:mm）" },
        "estimated": { "type": "boolean" },
        "fallback": { "const": "tdx-limit" }
      }
    },
    "place": { "type": "object", "required": ["name", "lat", "lon"], "properties": { "name": { "type": "string" }, "lat": { "type": ["number", "null"] }, "lon": { "type": ["number", "null"] } } },
    "option": {
      "type": "object",
      "required": ["id", "role", "name", "minutes", "waitMin", "walkMin", "cost", "arriveAt", "legs", "notes"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["walk", "bike", "bus", "metro", "thsr", "tra", "intercity", "ridehail", "drive"] },
        "name": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 0 },
        "waitMin": { "type": "integer", "minimum": 0 },
        "walkMin": { "type": "integer", "minimum": 0 },
        "cost": { "type": "integer", "minimum": 0 },
        "costRange": { "type": "array", "items": { "type": "integer" } },
        "exposure": { "type": "number", "minimum": 0, "maximum": 1 },
        "effort": { "type": "number", "minimum": 0, "maximum": 1 },
        "bike": { "type": "object", "description": "YouBike：起點借車站（count＝可借台數）、終點還車站（count＝空位）；tight＝數量少可能借不到／還不了；backup＝備用站" },
        "delayRisk": { "type": "number", "minimum": 0, "maximum": 1 },
        "arriveAt": { "type": "string" },
        "arriveMin": { "type": "integer" },
        "leaveAt": { "type": "string" },
        "estimated": { "type": "boolean" },
        "est": { "type": "object", "description": "估的部分（決策時保守看，core/decide.js UNCERTAIN）：true＝整個值、數字＝只有那幾分／幾元", "properties": { "minutes": { "type": ["boolean", "number"] }, "cost": { "type": ["boolean", "number"] } } },
        "lastBus": { "type": "boolean", "description": "公車末班快到了（23:00 後）" },
        "etaUnknown": { "type": "boolean", "description": "公車上車站的到站時間不明（站牌沒有預估或尚未發車）：決策不排在時間確定的大眾運輸前面" },
        "lastTrain": { "type": "boolean", "description": "捷運末班快到了（收班前 30 分）" },
        "longWait": { "type": "object", "description": "高鐵／台鐵／客運要等超過 60 分才有車（深夜等首班）：min＝真正要等幾分、extra＝比 waitMin 多等的分鐘、first＝那班幾點開；決策照抵達時間比（core/decide.js effMinutes）", "properties": { "min": { "type": "integer" }, "extra": { "type": "integer" }, "first": { "type": "string" } } },
        "transfers": { "type": "integer", "description": "轉乘次數（跨系統捷運：每一段的轉乘也算）" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "train": { "type": "object" },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "from", "to", "minutes", "detail"],
            "properties": {
              "mode": { "enum": ["walk", "bike", "bus", "transit", "metro", "thsr", "tra", "intercity", "ridehail", "drive"] },
              "from": { "$ref": "#/$defs/place" },
              "to": { "$ref": "#/$defs/place" },
              "minutes": { "type": "integer", "minimum": 0 },
              "detail": { "type": "string" },
              "detailEn": { "type": "string" },
              "nav": { "type": ["object", "null"] },
              "url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
